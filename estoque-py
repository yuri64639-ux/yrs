import sys

class CardapioSistema:
    def __init__(self):
        # Banco de dados inicial simulado em memória
        # Os insumos brutos do estoque são sempre pensados em Kg ou Litros
        self.insumos = ["Carne Moída", "Tomate", "Alface", "Cebola", "Azeite", "Frango", "Queijo", "Molho de Tomate", "Leite", "Farinha"]
        self.produtos = []

    def menu_principal(self):
        while True:
            print("\n" + "="*50)
            print("         SISTEMA DE CADASTRO DE CARDÁPIO")
            print("="*50)
            print("1 - Cadastrar Insumos em Massa (Estoque em Kg/L)")
            print("2 - Cadastrar Produto Comercial & Associar 6 Insumos")
            print("3 - Visualizar Cardápio e Fichas Técnicas")
            print("4 - Sair do Programa")
            print("="*50)
            
            opcao = input("Escolha uma opção: ").strip()
            
            if opcao == "1":
                self.cadastrar_insumos_massa()
            elif opcao == "2":
                self.cadastrar_produto_com_ficha()
            elif opcao == "3":
                self.visualizar_cardapio()
            elif opcao == "4":
                print("\nEncerrando o programa. Até logo!")
                sys.exit()
            else:
                print("\n[ERRO] Opção inválida! Tente novamente.")

    def cadastrar_insumos_massa(self):
        print("\n" + "-"*50)
        print("    CADASTRO DE INSUMOS EM MASSA (Estoque bruto: Kg ou L)")
        print("-"*50)
        print("Instruções: Digite ou cole os insumos desejados.")
        print("Envie uma linha EM BRANCO (aperte Enter sem digitar nada) para salvar.")
        print("-"*50)
        
        novos_insumos = []
        while True:
            item = input("Nome do insumo: ").strip()
            if item == "":
                break
            if item.lower() not in [i.lower() for i in self.insumos] and item.lower() not in [n.lower() for n in novos_insumos]:
                novos_insumos.append(item)
                print(f"-> '{item}' adicionado à fila.")
            else:
                print("-> [Aviso] Este insumo já está cadastrado ou já foi digitado.")
        
        if novos_insumos:
            self.insumos.extend(novos_insumos)
            print(f"\n[SUCESSO] {len(novos_insumos)} novos insumos foram adicionados ao banco de dados!")
        else:
            print("\n[Aviso] Nenhum insumo novo foi digitado.")

    def cadastrar_produto_com_ficha(self):
        print("\n" + "-"*50)
        print("            CADASTRO DE PRODUTO DO CARDÁPIO")
        print("-"*50)
        
        if len(self.insumos) < 6:
            print(f"\n[ERRO] Você tem apenas {len(self.insumos)} insumos cadastrados.")
            print("É necessário ter pelo menos 6 insumos cadastrados para montar a ficha técnica.")
            return

        nome_produto = input("Nome do prato/bebida comercial: ").strip()
        if not nome_produto:
            print("[ERRO] O nome do produto não pode ser vazio.")
            return
            
        preco_input = input("Preço de venda (R$): ").strip()
        try:
            preco_venda = float(preco_input.replace(",", "."))
            if preco_venda <= 0:
                raise ValueError
        except ValueError:
            print("[ERRO] Preço inválido! Insira um número maior do que zero.")
            return

        print("\n" + "-"*50)
        print("  VINCULAR EXATAMENTE 6 INSUMOS OBRIGATÓRIOS (g ou ml)")
        print("-"*50)
        print("Lista de insumos disponíveis:")
        for idx, insumo in enumerate(self.insumos, 1):
            print(f" [{idx}] {insumo}")
        print("-"*50)

        ficha_tecnica = []
        insumos_usados_neste_produto = set()

        for i in range(1, 7):
            while True:
                try:
                    escolha = int(input(f"\nEscolha o número do Insumo {i}/6: "))
                    if escolha < 1 or escolha > len(self.insumos):
                        print(f"[ERRO] Escolha um número válido entre 1 e {len(self.insumos)}.")
                        continue
                    
                    insumo_selecionado = self.insumos[escolha - 1]
                    
                    if insumo_selecionado in insumos_usados_neste_produto:
                        print(f"[ERRO] Você já adicionou '{insumo_selecionado}' neste produto. Escolha um insumo diferente.")
                        continue
                        
                    break
                except ValueError:
                    print("[ERRO] Digite um número inteiro correspondente ao insumo.")

            while True:
                try:
                    qtd_input = input(f"Quantidade gasta de '{insumo_selecionado}': ").strip()
                    qtd_num = float(qtd_input.replace(",", "."))
                    if qtd_num <= 0:
                        raise ValueError
                    break
                except ValueError:
                    print("[ERRO] Quantidade inválida! Digite apenas valores numéricos maiores que zero.")

            while True:
                unidade = input(f"Unidade de medida para a receita (g / ml): ").strip().lower()
                if unidade in ["g", "ml"]:
                    break
                print("[ERRO] Unidade inválida! Escolha estritamente 'g' para gramas ou 'ml' para mililitros.")

            # Realiza o cálculo de conversão automática para a baixa do estoque bruto (Kg/L)
            qtd_estoque_equivalente = qtd_num / 1000.0
            unidade_estoque = "kg" if unidade == "g" else "L"

            ficha_tecnica.append({
                "insumo": insumo_selecionado,
                "quantidade_receita": qtd_num,
                "unidade_receita": unidade,
                "equivalente_estoque": qtd_estoque_equivalente,
                "unidade_estoque": unidade_estoque
            })
            insumos_usados_neste_produto.add(insumo_selecionado)

        # Montagem do dicionário estruturado do produto comercializado
        novo_produto = {
            "nome": nome_produto,
            "preco": preco_venda,
            "ficha_tecnica": ficha_tecnica
        }
        self.produtos.append(novo_produto)
        
        print("\n" + "="*50)
        print(f"[SUCESSO] Produto '{nome_produto}' cadastrado com sucesso!")
        print("="*50)

    def visualizar_cardapio(self):
        print("\n" + "="*50)
        print("            CARDÁPIO COMPLETO E FICHAS TÉCNICAS")
        print("="*50)
        
        if not self.produtos:
            print("\nNenhum produto cadastrado no cardápio até o momento.")
            return

        for idx, prod in enumerate(self.produtos, 1):
            print(f"\n{idx}. Produto: {prod['nome']}")
            print(f"   Preço de Venda: R$ {prod['preco']:.2f}")
            print("   Ficha Técnica (Associações obrigatórias):")
            for item in prod['ficha_tecnica']:
                print(f"     • {item['insumo']}: {item['quantidade_receita']}{item['unidade_receita']} "
                      f"-> (Baixa calculada no estoque: {item['equivalente_estoque']:.3f} {item['unidade_estoque']})")
            print("-" * 50)

if __name__ == "__main__":
    app = CardapioSistema()
    app.menu_principal()
